{
    "system": {
        "whmcs_version": "8.13.6",
        "web_php_version": "7.4.33",
        "database_version": "10.11.19-MariaDB",
        "web_server": "Apache",
        "application_url_configured": true,
        "error_display_disabled": false,
        "configuration_file_writable": true
    },
    "php": {
        "memory_limit": "128M",
        "extensions": {
            "curl": true,
            "json": true,
            "mbstring": false,
            "openssl": true,
            "pdo": true,
            "pdo_mysql": true,
            "soap": false,
            "xml": true,
            "gd": false,
            "iconv": true,
            "intl": false,
            "zip": true,
            "zlib": true,
            "fileinfo": true,
            "bcmath": false,
            "ioncube_loader": false,
            "sodium": true
        }
    },
    "warnings": [
        {
            "code": "configuration_file_writable",
            "severity": "warning"
        }
    ],
    "collector": {
        "capabilities": [
            "web_php_version",
            "whmcs_version",
            "database_server_version",
            "php_extension_availability",
            "php_memory_limit",
            "configuration_file_writability"
        ],
        "limitations": [
            "cron_php_version_not_observable",
            "module_status_not_collected",
            "hosting_panel_configuration_not_observable",
            "ssl_certificate_not_verified"
        ]
    }
}
