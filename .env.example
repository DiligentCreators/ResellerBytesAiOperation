APP_NAME="ResellerBytes AI Operations"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=resellerbytes_ai_operation
DB_USERNAME=rb_runtime
DB_RUNTIME_ROLE=rb_runtime
DB_MIGRATION_ROLE=rb_migrator
DB_READONLY_ROLE=rb_readonly
DB_MIGRATION_USERNAME=rb_migrator
DB_MIGRATION_PASSWORD=
DB_READONLY_USERNAME=rb_readonly
DB_READONLY_PASSWORD=
DB_PASSWORD=
# Dedicated platform operations role for scheduled billing outbox/webhook reconciliation (PostgreSQL RLS bypass/owner privileges are provisioned separately).
# Dedicated rb_billing_ops login: BYPASSRLS, non-superuser, SELECT-only on the three billing queue/account tables.
# Provision and verify with docs/operations/postgresql-role-separation.md before enabling.
DB_OPERATIONS_HOST=
DB_OPERATIONS_PORT=5432
DB_OPERATIONS_DATABASE=
DB_OPERATIONS_USERNAME=
DB_OPERATIONS_PASSWORD=
DB_OPERATIONS_SSLMODE=require
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=false

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=120
CACHE_STORE=redis
CACHE_PREFIX=resellerbytes-ai-cache-
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=resellerbytes-ai-

WHMCS_ADDON_VERSION=1.0.0
WHMCS_ADDON_SIGNING_SECRET_KEY=
WHMCS_ADDON_SIGNING_PUBLIC_KEY=
# Sole central super-admin identity; must match an existing verified account.
OPERATIONS_OWNER_EMAIL=
OPERATIONS_ALERT_ERROR_RATE_WINDOW_MINUTES=5
OPERATIONS_ALERT_ERROR_RATE_PERCENT=2
OPERATIONS_ALERT_API_P95_LATENCY_MS=1500
OPERATIONS_ALERT_BACKUP_MAX_AGE_HOURS=26
OPERATIONS_ALERT_DISK_WARNING_PERCENT=80
OPERATIONS_ALERT_DISK_CRITICAL_PERCENT=90
OPERATIONS_ALERT_QUEUE_JOB_MAX_AGE_MINUTES=15
OPERATIONS_ALERT_BILLING_STALE_PROCESSING_MINUTES=5
OPERATIONS_ALERTS_ENABLED=false
OPERATIONS_ALERT_REPEAT_INTERVAL_MINUTES=15
OPERATIONS_BACKUP_SUCCESS_MARKER_PATH=
OPERATIONS_ALERT_EMAIL=
OPERATIONS_ALERT_SLACK_WEBHOOK_URL=
OPERATIONS_ALERT_DISCORD_WEBHOOK_URL=
OPERATIONS_ALERT_CRITICAL_WHATSAPP_WEBHOOK_URL=
OPERATIONS_ALERT_CRITICAL_SMS_WEBHOOK_URL=
RECOVERY_POINT_OBJECTIVE_HOURS=24
RECOVERY_TIME_OBJECTIVE_HOURS=4
PRODUCTION_RESTORE_REQUIRES_OWNER_APPROVAL=true
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_OBJECT_LOCK_MODE=COMPLIANCE
AUDIT_SIGNING_OPERATOR=owner
DIAGNOSTICS_RETENTION_CLEANUP_ENABLED=false

AUDIT_ANCHOR_PRIVATE_KEY=
AUDIT_ANCHOR_PUBLIC_KEY=
AUDIT_ANCHOR_BUCKET=
AUDIT_ANCHOR_ENDPOINT=
AUDIT_ANCHOR_REGION=us-east-1
AUDIT_ANCHOR_AWS_CLI_BINARY=aws
AUDIT_ANCHOR_AWS_ACCESS_KEY_ID=
AUDIT_ANCHOR_AWS_SECRET_ACCESS_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT=45
AI_DAILY_BUDGET_MICRO_USD=5000000
AI_MONTHLY_BUDGET_MICRO_USD=50000000
AI_MAX_INPUT_BYTES=65536
AI_MAX_OUTPUT_TOKENS=3000

# Central platform mail fallbacks; database settings take precedence. Secrets stay blank here.
PLATFORM_MAIL_DRIVER=log
PLATFORM_MAIL_FROM_ADDRESS=
PLATFORM_MAIL_FROM_NAME=
PLATFORM_MAIL_SMTP_HOST=
PLATFORM_MAIL_SMTP_PORT=
PLATFORM_MAIL_SMTP_ENCRYPTION=
PLATFORM_MAIL_SMTP_USERNAME=
PLATFORM_MAIL_SMTP_PASSWORD=
PLATFORM_MAIL_POSTMARK_SERVER_TOKEN=
PLATFORM_MAIL_POSTMARK_MESSAGE_STREAM=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
BACKUP_ENCRYPTION_KEY=
BACKUP_OBJECT_LOCK_RETENTION_DAYS=
BACKUP_AWS_CLI_BINARY=aws
BACKUP_PG_DUMP_BINARY=pg_dump
BACKUP_PG_RESTORE_BINARY=pg_restore
BACKUP_DB_USERNAME=rb_readonly
BACKUP_DB_PASSWORD=
RESTORE_DB_USERNAME=rb_migrator
RESTORE_DB_PASSWORD=
OPERATIONS_BACKUPS_ENABLED=false
OPERATIONS_BACKUP_SCHEDULE_TIME=00:00
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Provisional billing retry grace policy; review before external billing activation.
BILLING_PAYMENT_FAILURE_GRACE_DAYS=7
