APP_NAME="ResellerBytes AI Operations"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The operations app uses PostgreSQL. WHMCS keeps its existing MariaDB database.
# Use a dedicated least-privilege PostgreSQL role; do not use the postgres superuser.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=resellerbytes_ai_operation
DB_USERNAME=resellerbytes_ai
DB_PASSWORD=
# Production PostgreSQL: configure the provider CA and set DB_SSLMODE=verify-full.
# Keep certificate and hostname verification enabled; do not use sslmode=disable.
# DB_SSLMODE=verify-full

# Optional SQL Server connection (for isolated integration tooling only).
# Encryption is enabled and trusting an unverified server certificate is disabled.
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=false

# Redis is the default backend for sessions, cache, and background queues.
# Keep Redis bound to localhost/private networking and protect it with authentication.
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=120

CACHE_STORE=redis
CACHE_PREFIX=resellerbytes-ai-cache-

# Use phpredis (the native PHP extension) for low-overhead Redis access.

# WHMCS addon release version exposed in the authenticated dashboard.
WHMCS_ADDON_VERSION=1.0.0
# Base64-encoded libsodium Ed25519 secret key (64 bytes) and public key (32 bytes).
# Store the private key in the deployment secret manager; never commit it.
WHMCS_ADDON_SIGNING_SECRET_KEY=
WHMCS_ADDON_SIGNING_PUBLIC_KEY=
# Independent audit-anchor keys; never reuse the WHMCS addon signing key or APP_KEY.
# Provision these in a separate secret manager and distribute the public key independently.
AUDIT_ANCHOR_PRIVATE_KEY=
AUDIT_ANCHOR_PUBLIC_KEY=
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=resellerbytes-ai-

# AI analysis is disabled until a server-side OpenAI API key is configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT=45

# Global AI spend controls (USD stored as integer micro-USD).
AI_DAILY_BUDGET_MICRO_USD=5000000
AI_MONTHLY_BUDGET_MICRO_USD=50000000
AI_MAX_INPUT_BYTES=65536
AI_MAX_OUTPUT_TOKENS=3000

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
